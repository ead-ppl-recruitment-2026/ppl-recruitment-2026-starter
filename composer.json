{
    "name": "ead-laboratory/ppl-room-reservation-starter",
    "type": "project",
    "description": "Starter Laravel application for the EAD Laboratory Campus Room Reservation study case.",
    "keywords": ["laravel", "ppl", "room-reservation", "starter"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.24",
        "nunomaduro/collision": "^8.8",
        "mockery/mockery": "1.6.15",
        "laravel/dusk": "8.6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": "@php artisan migrate --seed",
        "test": "@php artisan test",
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
